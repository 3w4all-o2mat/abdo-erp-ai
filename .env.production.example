# =============================================================================
# .env.production — TEMPLATE
# Copy this file to `.env.production` on the VPS (NOT in the repo) and fill
# in real values. The file must be chmod 600.
#
#   scp .env.production.example ubuntu@YOUR_VPS_IP:/home/ubuntu/abdo-erp-ai/.env.production
#   ssh ubuntu@YOUR_VPS_IP "chmod 600 /home/ubuntu/abdo-erp-ai/.env.production"
#
# Generate strong secrets with:
#   openssl rand -base64 32
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
# =============================================================================

# ---- Postgres (used by the `postgres` service in docker-compose.yml) ----
POSTGRES_USER=appuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=mini_erp

# ---- Connection string used by the Next.js app (matches the service name `postgres`) ----
DATABASE_URL=postgresql://appuser:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/mini_erp

# ---- NextAuth / Auth.js ----
# Two independent strong random values, generated with `openssl rand -base64 32`.
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32
NEXTAUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32

# Public URL where the app is served (no trailing slash).
NEXTAUTH_URL=http://YOUR_VPS_IP:3000
