generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  username         String            @unique
  password         String
  fullName         String
  email            String?           @unique
  phone            String?
  defaultStockId   String?
  isActive         Boolean           @default(true) @map("is_active")
  lastLogin        DateTime?         @map("last_login")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  activityLogs     ActivityLog[]
  invoices         Invoice[]
  orders           Order[]
  purchases        Purchase[]
  quotations       Quotation[]
  stockAdjustments StockAdjustment[]
  stockTransfers   StockTransfer[]
  stockUsers       StockUser[]
  roles            UserRole[]
  defaultStock     Stock?            @relation("UserDefaultStock", fields: [defaultStockId], references: [id])

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Module {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  nextNumber  Int          @default(1) @map("next_number")
  namingDoc   String       @map("naming_doc")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  permissions Permission[]

  @@map("modules")
}

model Permission {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  moduleId  String           @map("module_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  module    Module           @relation(fields: [moduleId], references: [id])
  roles     RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Client {
  id         String          @id @default(cuid())
  name       String
  phone      String?
  address    String?
  email      String?
  taxId      String?         @map("tax_id")
  wilayaId   Int?            @map("wilaya_id")
  communeId  Int?            @map("commune_id")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  commune    Commune?        @relation("ClientCommune", fields: [communeId], references: [id])
  wilaya     Wilaya?         @relation("ClientWilaya", fields: [wilayaId], references: [id])
  invoices   Invoice[]
  orders     Order[]
  payments   PaymentClient[]
  quotations Quotation[]

  @@map("clients")
}

model Supplier {
  id        String            @id @default(cuid())
  name      String
  phone     String?
  address   String?
  email     String?
  taxId     String?           @map("tax_id")
  wilayaId  Int?              @map("wilaya_id")
  communeId Int?              @map("commune_id")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  payments  PaymentSupplier[]
  purchases Purchase[]
  commune   Commune?          @relation("SupplierCommune", fields: [communeId], references: [id])
  wilaya    Wilaya?           @relation("SupplierWilaya", fields: [wilayaId], references: [id])

  @@map("suppliers")
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  parentId  String?           @map("parent_id")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@map("product_categories")
}

model Product {
  id                String                   @id @default(cuid())
  sku               String                   @unique
  barcode           String?
  name              String
  displayName       String?                  @map("display_name")
  productCategoryId String                   @map("product_category_id")
  unitOfMeasure     String                   @default("pcs") @map("unit_of_measure")
  isStockable       Boolean                  @default(true) @map("is_stockable")
  isActive          Boolean                  @default(true) @map("is_active")
  currentPriceId    String?                  @unique @map("current_price_id")
  costPrice         Decimal                  @default(0) @map("cost_price") @db.Decimal(12, 2)
  marqueFiltreId    String?                  @map("marque_filtre_id")
  moteurId          String?                  @map("moteur_id")
  age               String?
  carburant         String?
  filterType        String?                  @map("filter_type")
  referenceFilter   String?                  @map("reference_filter")
  image             String?
  description       String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  invoiceLines      InvoiceLine[]
  orderLines        OrderLine[]
  currentPrice      ProductPrice?            @relation("CurrentPrice", fields: [currentPriceId], references: [id])
  category          ProductCategory          @relation(fields: [productCategoryId], references: [id])
  marqueFiltre      ProductMarqueFiltre?     @relation(fields: [marqueFiltreId], references: [id])
  moteur            ProductMoteur?           @relation(fields: [moteurId], references: [id])
  prices            ProductPrice[]
  purchaseLines     PurchaseLine[]
  quotationLines    QuotationLine[]
  adjustmentLines   StockAdjustmentLine[]
  stockMovements    StockMovement[]
  transferLines     StockTransferLine[]
  marquesMaisons    ProductsMarquesMaison[]

  @@map("products")
}

model ProductPrice {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  name          String?
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")
  currentFor    Product? @relation("CurrentPrice")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("products_prices")
}

model Quotation {
  id           String          @id @default(cuid())
  reference    String          @unique
  date         DateTime        @default(now())
  expiringDate DateTime?       @map("expiring_date")
  status       String          @default("draft")
  clientId     String          @map("client_id")
  userId       String          @map("user_id")
  stockId      String          @map("stock_id")
  orderId      String?         @unique @map("order_id")
  withTva      Boolean         @default(true) @map("with_tva")
  withRemise   Boolean         @default(true) @map("with_remise")
  remiseAmount Decimal         @default(0) @map("remise_amount") @db.Decimal(14, 2)
  htAmount     Decimal         @default(0) @map("ht_amount") @db.Decimal(14, 2)
  tvaAmount    Decimal         @default(0) @map("tva_amount") @db.Decimal(14, 2)
  ttcAmount    Decimal         @default(0) @map("ttc_amount") @db.Decimal(14, 2)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  client       Client          @relation(fields: [clientId], references: [id])
  order        Order?          @relation(fields: [orderId], references: [id])
  stock        Stock           @relation(fields: [stockId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  lines        QuotationLine[]

  @@index([stockId])
  @@map("quotations")
}

model QuotationLine {
  id           String    @id @default(cuid())
  quotationId  String    @map("quotation_id")
  productId    String    @map("product_id")
  designation  String
  qty          Decimal   @db.Decimal(12, 3)
  unitPrice    Decimal   @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal   @default(0) @map("discount_rate") @db.Decimal(5, 2)
  vatRate      Decimal   @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount       Decimal   @db.Decimal(14, 2)
  product      Product   @relation(fields: [productId], references: [id])
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotations_lines")
}

model Order {
  id             String         @id @default(cuid())
  reference      String         @unique
  date           DateTime       @default(now())
  status         String         @default("draft")
  clientId       String         @map("client_id")
  userId         String         @map("user_id")
  stockId        String         @map("stock_id")
  withTva        Boolean        @default(true) @map("with_tva")
  withRemise     Boolean        @default(true) @map("with_remise")
  remiseAmount   Decimal        @default(0) @map("remise_amount") @db.Decimal(14, 2)
  htAmount       Decimal        @default(0) @map("ht_amount") @db.Decimal(14, 2)
  tvaAmount      Decimal        @default(0) @map("tva_amount") @db.Decimal(14, 2)
  ttcAmount      Decimal        @default(0) @map("ttc_amount") @db.Decimal(14, 2)
  paymentDisplay String?        @map("payment_display")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  invoices       Invoice[]
  client         Client         @relation(fields: [clientId], references: [id])
  stock          Stock          @relation(fields: [stockId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  lines          OrderLine[]
  payments       PaymentClient[]
  quotation      Quotation?

  @@map("orders")
}

model OrderLine {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  productId    String   @map("product_id")
  designation  String
  qty          Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  vatRate      Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount       Decimal  @db.Decimal(14, 2)
  invoiceId    String?  @map("invoice_id")
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@map("orders_lines")
}

model Invoice {
  id           String         @id @default(cuid())
  reference    String         @unique
  date         DateTime       @default(now())
  status       String         @default("draft")
  clientId     String         @map("client_id")
  userId       String         @map("user_id")
  orderId      String?        @map("order_id")
  withTva      Boolean        @default(true) @map("with_tva")
  withRemise   Boolean        @default(true) @map("with_remise")
  remiseAmount Decimal        @default(0) @map("remise_amount") @db.Decimal(14, 2)
  htAmount     Decimal        @default(0) @map("ht_amount") @db.Decimal(14, 2)
  tvaAmount    Decimal        @default(0) @map("tva_amount") @db.Decimal(14, 2)
  ttcAmount    Decimal        @default(0) @map("ttc_amount") @db.Decimal(14, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  client       Client         @relation(fields: [clientId], references: [id])
  order        Order?         @relation(fields: [orderId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  lines        InvoiceLine[]
  orderLines   OrderLine[]

  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(cuid())
  invoiceId    String  @map("invoice_id")
  productId    String  @map("product_id")
  designation  String
  qty          Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  vatRate      Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount       Decimal @db.Decimal(14, 2)
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("invoices_lines")
}

model Purchase {
  id           String            @id @default(cuid())
  reference    String            @unique
  date         DateTime          @default(now())
  status       String            @default("draft")
  supplierId   String            @map("supplier_id")
  userId       String            @map("user_id")
  stockId      String            @map("stock_id")
  withTva      Boolean           @default(true) @map("with_tva")
  withRemise   Boolean           @default(true) @map("with_remise")
  remiseAmount Decimal           @default(0) @map("remise_amount") @db.Decimal(14, 2)
  htAmount     Decimal           @default(0) @map("ht_amount") @db.Decimal(14, 2)
  tvaAmount    Decimal           @default(0) @map("tva_amount") @db.Decimal(14, 2)
  ttcAmount    Decimal           @default(0) @map("ttc_amount") @db.Decimal(14, 2)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  payments     PaymentSupplier[]
  stock        Stock             @relation(fields: [stockId], references: [id])
  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  lines        PurchaseLine[]

  @@map("purchases")
}

model PurchaseLine {
  id           String   @id @default(cuid())
  purchaseId   String   @map("purchase_id")
  productId    String   @map("product_id")
  designation  String
  qty          Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  vatRate      Decimal  @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount       Decimal  @db.Decimal(14, 2)
  product      Product  @relation(fields: [productId], references: [id])
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchases_lines")
}

model Stock {
  id              String            @id @default(cuid())
  name            String
  address         String?
  isDefault       Boolean           @default(false) @map("is_default")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  orders          Order[]
  purchases       Purchase[]
  quotations      Quotation[]
  adjustments     StockAdjustment[]
  movements       StockMovement[]
  transfersFrom   StockTransfer[]   @relation("TransferFrom")
  transfersTo     StockTransfer[]   @relation("TransferTo")
  users           StockUser[]
  defaultForUsers User[]            @relation("UserDefaultStock")

  @@map("stocks")
}

model StockUser {
  stockId String
  userId  String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([stockId, userId])
  @@map("stock_users")
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  stockId    String   @map("stock_id")
  qtySigned  Decimal  @map("qty_signed") @db.Decimal(14, 3)
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  date       DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id])
  stock      Stock    @relation(fields: [stockId], references: [id])

  @@index([productId, stockId])
  @@map("stock_movements")
}

model StockTransfer {
  id          String              @id @default(cuid())
  date        DateTime            @default(now())
  fromStockId String              @map("from_stock_id")
  toStockId   String              @map("to_stock_id")
  userId      String              @map("user_id")
  status      String              @default("draft")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  reference   String              @unique
  fromStock   Stock               @relation("TransferFrom", fields: [fromStockId], references: [id])
  toStock     Stock               @relation("TransferTo", fields: [toStockId], references: [id])
  user        User                @relation(fields: [userId], references: [id])
  lines       StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id              String        @id @default(cuid())
  stockTransferId String        @map("stock_transfer_id")
  productId       String        @map("product_id")
  qty             Decimal       @db.Decimal(12, 3)
  product         Product       @relation(fields: [productId], references: [id])
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@map("stock_transfers_lines")
}

model StockAdjustment {
  id        String                @id @default(cuid())
  stockId   String                @map("stock_id")
  date      DateTime              @default(now())
  userId    String                @map("user_id")
  reason    String?
  status    String                @default("draft")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  reference String                @unique
  stock     Stock                 @relation(fields: [stockId], references: [id])
  user      User                  @relation(fields: [userId], references: [id])
  lines     StockAdjustmentLine[]

  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                String          @id @default(cuid())
  stockAdjustmentId String          @map("stock_adjustment_id")
  productId         String          @map("product_id")
  qtySigned         Decimal         @map("qty_signed") @db.Decimal(14, 3)
  product           Product         @relation(fields: [productId], references: [id])
  stockAdjustment   StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)

  @@map("stock_adjustments_lines")
}

model PaymentClient {
  id            String   @id @default(cuid())
  clientId      String   @map("client_id")
  date          DateTime @default(now())
  amount        Decimal  @db.Decimal(14, 2)
  paymentMethod String   @map("payment_method")
  orderId       String?  @map("order_id")
  observation   String?
  createdAt     DateTime @default(now()) @map("created_at")
  client        Client   @relation(fields: [clientId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])

  @@map("payments_clients")
}

model PaymentSupplier {
  id            String    @id @default(cuid())
  supplierId    String    @map("supplier_id")
  date          DateTime  @default(now())
  amount        Decimal   @db.Decimal(14, 2)
  paymentMethod String    @map("payment_method")
  purchaseId    String?   @map("purchase_id")
  observation   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@map("payments_suppliers")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expenses  Expense[]

  @@map("expenses_categories")
}

model Expense {
  id                String          @id @default(cuid())
  expenseCategoryId String          @map("expense_category_id")
  date              DateTime        @default(now())
  amount            Decimal         @db.Decimal(14, 2)
  observation       String?
  createdAt         DateTime        @default(now()) @map("created_at")
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])

  @@map("expenses")
}

model Setting {
  key       String   @id
  value     String
  category  String   @default("general")
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Wilaya {
  id        Int        @id
  codew     String?    @map("codew")
  name      String
  clients   Client[]   @relation("ClientWilaya")
  communes  Commune[]
  suppliers Supplier[] @relation("SupplierWilaya")

  @@map("wilayates")
}

model Commune {
  id        Int        @id @default(autoincrement())
  wilayaId  Int        @map("wilaya_id")
  name      String
  clients   Client[]   @relation("ClientCommune")
  wilaya    Wilaya     @relation(fields: [wilayaId], references: [id])
  suppliers Supplier[] @relation("SupplierCommune")

  @@map("communes")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("activity_logs")
}

model ContentBlock {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  image     String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_blocks")
}

model ProductZone {
  id            String               @id @default(cuid())
  name          String
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  marquesMaisons ProductMarqueMaison[]

  @@map("product_zones")
}

model ProductMarqueMaison {
  id                    String                 @id @default(cuid())
  name                  String
  zoneId                String?                @map("zone_id")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  zone                  ProductZone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  marquesMaisons        ProductsMarquesMaison[]

  @@map("product_marques_maison")
}

model ProductsMarquesMaison {
  productId             String              @map("product_id")
  productMarqueMaisonId String              @map("product_marque_maison_id")
  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  marqueMaison          ProductMarqueMaison @relation(fields: [productMarqueMaisonId], references: [id], onDelete: Cascade)

  @@id([productId, productMarqueMaisonId])
  @@map("products_marques_maison")
}

model ProductMoteur {
  id        String    @id @default(cuid())
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("product_moteurs")
}

model ProductTypeMoteur {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_types_moteur")
}

model ProductMarqueFiltre {
  id        String    @id @default(cuid())
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("product_marques_filtre")
}
